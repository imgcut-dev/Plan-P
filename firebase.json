{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "design-system/**",
      "CLAUDE.md",
      "docs/**",
      "tests/**",
      "tools/**",
      "DESIGN.md",
      "firestore.rules",
      "weather.html",
      "cat.html"
    ],
    "rewrites": [
      {
        "source": "/post/**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
